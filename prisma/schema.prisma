// Euro Brands — Prisma Schema
// نظام إدارة المخزون والمبيعات

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // عند استخدام Vercel Postgres مع Migrate، فعّل السطر التالي:
  // directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
//  Enums
// ----------------------------------------------------

enum Category {
  CLOTHES // ملابس
  SHOES // أحذية
  PERFUMES // عطور
  PANTS // بناطيل
}

enum Branch {
  HADAYEK // حدائق المعادي
  ZAHRAA // زهراء المعادي
}

enum DiscountType {
  PERCENTAGE // نسبة مئوية %
  FIXED // مبلغ ثابت
}

enum PaymentMethod {
  CASH // كاش
  VISA // فيزا
  TRANSFER // تحويل
}

enum SaleStatus {
  COMPLETED // مكتملة
  CANCELLED // ملغية
}

enum DeliveryMethod {
  CUSTOM // عامل خاص
  BOSTA
}

enum OrderSource {
  PHONE // تليفون
  FACEBOOK // فيسبوك
  INSTAGRAM // انستجرام
  WHATSAPP // واتساب
  MESSENGER // ماسنجر
}

enum DeliveryStatus {
  NEW // جديد
  PREPARING // قيد التجهيز
  READY // جاهز للشحن
  OUT_FOR_DELIVERY // خرج للتوصيل
  DELIVERED // تم التوصيل
  RETURNED // مرتجع
}

// ----------------------------------------------------
//  Models
// ----------------------------------------------------

model Product {
  id          String   @id @default(cuid())
  name        String
  brand       String
  category    Category
  description String?
  sku         String? // (مهجور) كان كود المنتج — الآن لكل صنف SKU خاص به
  barcode     String? // الباركود (اختياري)
  images      String[] @default([]) // حتى 3 صور
  isDraft     Boolean  @default(false) // مسودة أُضيفت سريعاً من POS وتحتاج إكمال بياناتها

  productTypeId String?
  productType   ProductType? @relation(fields: [productTypeId], references: [id], onDelete: SetNull)

  variants  ProductVariant[]
  saleItems SaleItem[]

  archivedAt DateTime? // وقت الأرشفة (حذف مؤجّل بعد 72 ساعة) — إدارة البيانات

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([brand])
  @@index([productTypeId])
  @@index([archivedAt])
}

// سجل البراندات لكل فئة (لقوائم الاختيار والفلاتر)
model Brand {
  id        String   @id @default(cuid())
  name      String
  category  Category
  createdAt DateTime @default(now())

  @@unique([name, category])
  @@index([category])
}

// أنواع المنتجات لكل فئة (مثلاً: تيشيرت/قميص داخل «ملابس»، حذاء رياضي/كلاسيك داخل «أحذية»)
// الـ code يُستخدم كبادئة لتوليد SKU التلقائي لكل صنف.
model ProductType {
  id        String   @id @default(cuid())
  name      String
  code      String // بادئة قصيرة (TSH, SNK, ...) تظهر في الـ SKU
  category  Category
  createdAt DateTime @default(now())

  products Product[]

  @@unique([name, category])
  @@index([category])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size        String // XS S M L XL 2XL 3XL 4XL 5XL أو مقاسات أرقام للأحذية
  color       String? // لون الصنف (اختياري)
  quantity    Int    @default(0)
  minQuantity Int    @default(5) // الحد الأدنى للتنبيه بقلة المخزون
  alertOnLowStock Boolean @default(false) // تفعيل جرس التنبيه عند بلوغ الحد الأدنى لهذا الصنف
  branch      Branch
  price       Float // سعر البيع لكل صنف بالجنيه المصري
  cost        Float  @default(0) // تكلفة الوحدة (متوسط مرجّح) — تُحدَّث مع كل استلام بضاعة (Part D)
  sku         String? @unique // كود الصنف (يولَّد تلقائياً أو يُدخَل يدوياً)
  skuManual   Boolean @default(false) // علامة أن المستخدم عدّل الكود يدوياً (لا يُعاد توليده)

  saleItems SaleItem[]

  returnItems         ReturnItem[] @relation("ReturnedVariant") // أُرجِع هذا الصنف
  exchangeReturnItems ReturnItem[] @relation("ExchangeVariant") // اُستُبدِل إلى هذا الصنف
  stockReceiptItems   StockReceiptItem[] // بنود استلام البضاعة لهذا الصنف

  @@unique([productId, size, branch, color])
  @@index([productId])
  @@index([branch])
}

model Sale {
  id         String  @id @default(cuid())
  saleNumber Int     @unique // رقم فاتورة تصاعدي عام
  // مفتاح تفرّد يولّده العميل (POS) — يمنع تكرار الفاتورة عند إعادة إرسال طابور
  // وضع عدم الاتصال أو تكرار الطلب بعد انقطاع الرد. اختياري (الفواتير القديمة null).
  clientRef  String? @unique
  branch     Branch

  totalAmount   Float // الإجمالي قبل الخصم
  discountType  DiscountType?
  discountValue Float         @default(0)
  finalAmount   Float // الصافي بعد الخصم

  customerName  String?
  customerPhone String?
  customerNotes String?

  paymentMethod   PaymentMethod @default(CASH)
  transferMethod  String? // فودافون كاش / انستا باي (عند التحويل)
  invoiceNotes    String? // ملاحظات على الفاتورة (مستقلة عن ملاحظات العميل)
  paidAmount      Float         @default(0) // المبلغ المدفوع
  remainingAmount Float         @default(0) // المبلغ المتبقي
  changeAmount    Float? // الباقي للعميل عند الدفع نقداً (دفع العميل − إجمالي الفاتورة)
  cashierName     String? // اسم الكاشير الذي أنشأ الفاتورة

  status             SaleStatus @default(COMPLETED)
  cancellationReason String? // سبب الإلغاء

  // فتح فاتورة مقفلة يدوياً (بعد تجاوزها مدة القفل) — يُسجَّل في سجل النشاط
  unlockedAt   DateTime? // وقت فتح القفل يدوياً (إن وُجد)
  unlockedBy   String? // من قام بفتح القفل
  unlockReason String? // سبب فتح القفل

  isDelivery       Boolean         @default(false)
  orderSource      OrderSource? // مصدر الطلب
  deliveryMethod   DeliveryMethod?
  deliveryAddress  String?
  addressNotes     String?
  trackingNumber   String? // رقم تتبع شركة الشحن (Bosta)
  deliveryStatus   DeliveryStatus?

  items   SaleItem[]
  returns Return[] // عمليات الإرجاع/الاستبدال على هذه الفاتورة

  archivedAt DateTime? // وقت الأرشفة (حذف مؤجّل بعد 72 ساعة) — إدارة البيانات

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // يُضبط تلقائياً عند أي تعديل — يُستخدم لـ«آخر تعديل»

  @@index([branch])
  @@index([createdAt])
  @@index([status])
  @@index([isDelivery])
  @@index([deliveryStatus])
  @@index([archivedAt])
}

model SaleItem {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantity  Int
  unitPrice Float
  subtotal  Float // الصافي بعد خصم الصنف (unitPrice × quantity − خصم الصنف)

  note             String? // ملاحظة على الصنف (اختيارية)
  itemDiscount     Float  @default(0) // قيمة خصم الصنف (نسبة أو مبلغ حسب النوع)
  itemDiscountType String @default("FIXED") // نوع خصم الصنف: 'PERCENTAGE' أو 'FIXED'

  returnItems ReturnItem[] // بنود الإرجاع المرتبطة بهذا البند

  @@index([saleId])
  @@index([productId])
}

// العملاء — سجل العملاء وتاريخ زياراتهم وإجمالي إنفاقهم
model Customer {
  id          String    @id @default(cuid())
  name        String
  phone       String?   @unique // اختياري — يُحفظ العميل بالاسم أو الهاتف (أحدهما يكفي)
  totalSpent  Float     @default(0)
  visitCount  Int       @default(0)
  lastVisitAt DateTime?
  branch      Branch? // الفرع الذي يتردد عليه غالباً
  notes       String?

  archivedAt DateTime? // وقت الأرشفة (حذف مؤجّل بعد 72 ساعة) — إدارة البيانات

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([totalSpent])
  @@index([lastVisitAt])
  @@index([archivedAt])
}

// طلبات دخول الكاشير (تدفّق «نسيت كلمة المرور») — يراها المدير ويوافق/يرفض
model AccessRequest {
  id         String    @id @default(cuid())
  name       String // الاسم الذي أدخله الكاشير
  status     String    @default("PENDING") // PENDING / APPROVED / REJECTED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime? // وقت الموافقة/الرفض

  @@index([status])
  @@index([createdAt])
}

// مخزن إعدادات عام (مفتاح/قيمة) — يُستخدم لاسترجاع حساب المدير (سؤال الأمان + بصمة الإجابة)
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// سجل نشاط المستخدمين (تسجيل دخول، إنشاء/إلغاء فاتورة، عمليات المنتجات، التوصيل)
model ActivityLog {
  id        String   @id @default(cuid())
  userName  String
  userRole  String // ADMIN / CASHIER
  action    String // وصف الإجراء بالعربية
  details   String? // تفاصيل إضافية (اختياري)

  archivedAt DateTime? // وقت الأرشفة (حذف مؤجّل بعد 72 ساعة) — إدارة البيانات

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userName])
  @@index([archivedAt])
}

// تحويلات المخزون بين الفرعين (نموذج لجدول قائم في قاعدة البيانات)
model StockTransfer {
  id          String    @id @default(cuid())
  fromBranch  Branch // الفرع المُرسِل
  toBranch    Branch // الفرع المستقبِل
  status      String    @default("PENDING") // PENDING / COMPLETED / CANCELLED
  notes       String?
  createdBy   String? // اسم منشئ التحويل
  createdAt   DateTime  @default(now())
  completedAt DateTime? // وقت اكتمال التحويل

  items StockTransferItem[]

  @@index([status])
  @@index([createdAt])
}

model StockTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  productId String // مرجع للمنتج (بدون علاقة إلزامية لتفادي تعديل جداول أخرى)
  variantId String // مرجع للصنف
  size      String
  color     String?
  quantity  Int

  @@index([transferId])
}

// تقرير الديفو — المنتجات التالفة/المعيبة
// تسجيل التلف يخصم الكمية من المخزون داخل معاملة ويُدوَّن في سجل النشاط.
// أسماء الأعمدة مطابقة تماماً لجدول قاعدة البيانات القائم.
model DamagedItem {
  id        String   @id @default(cuid())
  productId String // مرجع للمنتج
  variantId String? // مرجع للصنف (يُخصَم منه المخزون)
  branch    Branch // فرع التلف
  quantity  Int      @default(1)
  reason    String? // كود سبب التلف (أحد قيم DEFECT_REASONS)
  detail    String? // تفاصيل إضافية/سبب حر (خاصة عند «أخرى»)
  unitCost  Float    @default(0) // تكلفة/سعر الوحدة لحظة التسجيل (لحساب الخسارة)
  photoUrl  String? // صورة اختيارية للعيب

  // الحالة (التصرّف) وأثرها على المخزون — أحد قيم DEFECT_CONDITIONS:
  //   TOTAL_LOSS        = تالف بالكامل: يُخصَم من المخزون، خسارة صافية (الافتراضي)
  //   SELL_AT_DISCOUNT  = يُباع بخصم: يبقى في المخزون بسعر مخفّض (discountPrice)
  //   RETURN_TO_SUPPLIER= يُرجع للمورد: يُخصَم من المخزون ويُربَط بمورد (supplierId)
  condition     String  @default("TOTAL_LOSS")
  discountPrice Float? // سعر البيع بخصم (عند SELL_AT_DISCOUNT فقط)
  // عدد الوحدات المتبقية للبيع بخصم (يبدأ = quantity ويُستهلَك مع كل بيع).
  // null للحالات الأخرى؛ 0 يعني نفد المخزون المخفّض فيختفي وسم «تالف/خصم».
  discountRemaining Int?
  supplierId    String? // المورد (عند RETURN_TO_SUPPLIER فقط)
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([condition])
  @@index([supplierId])
}

// ----------------------------------------------------
//  المرتجعات والاستبدال (Returns & Exchanges)
//  إرجاع/استبدال أصناف من فاتورة قائمة — جزئي (بند واحد أو أكثر).
//  عند التأكيد: تعود كمية المُرتجَع للمخزون، وتُخصَم كمية البديل (للاستبدال).
//  type/refundMethod كنصوص (كباقي الجداول اللاحقة) لتفادي إنشاء أنواع enum.
// ----------------------------------------------------
model Return {
  id     String @id @default(cuid())
  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  branch Branch // فرع تنفيذ العملية (نفس فرع الفاتورة)
  type   String @default("RETURN") // 'RETURN' | 'EXCHANGE'
  reason String? // سبب الإرجاع/الاستبدال (اختياري)

  refundMethod       String? // ملاحظة فقط: cash / card / store_credit (لا محفظة)
  refundTotal        Float   @default(0) // إجمالي المبلغ المُعاد للعميل
  exchangeDifference Float   @default(0) // فرق السعر (+ يدفع العميل / − يُرد له)

  createdBy String? // اسم منفّذ العملية
  createdAt DateTime @default(now())

  items ReturnItem[]

  @@index([saleId])
  @@index([createdAt])
  @@index([branch])
  @@index([type])
}

model ReturnItem {
  id       String @id @default(cuid())
  returnId String
  return   Return @relation(fields: [returnId], references: [id], onDelete: Cascade)

  saleItemId String // البند الأصلي في الفاتورة
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  variantId String // الصنف المُرتجَع (يعود للمخزون)
  variant   ProductVariant @relation("ReturnedVariant", fields: [variantId], references: [id], onDelete: Restrict)

  quantity     Int
  refundAmount Float @default(0) // قيمة هذا البند المُرتجَع

  exchangeVariantId String? // الصنف البديل (للاستبدال — يُخصَم من المخزون)
  exchangeVariant   ProductVariant? @relation("ExchangeVariant", fields: [exchangeVariantId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([saleItemId])
  @@index([variantId])
}

// ----------------------------------------------------
//  إقفال الصندوق / تسوية النقدية (Part A)
//  «بدء الشيفت»: يفتح صف بعهدة البداية (closedAt = null).
//  «إقفال الشيفت»: يُحسب المتوقع (عهدة + كاش مبيعات − كاش مرتجعات)، يدخل الكاشير
//  المعدود، ويُسجَّل الفرق (زيادة/عجز) مع وقت الإقفال.
// ----------------------------------------------------
model ShiftClose {
  id           String    @id @default(cuid())
  branch       Branch
  cashierName  String? // اسم الكاشير
  openingCash  Float     @default(0) // عهدة بداية الشيفت
  expectedCash Float     @default(0) // محسوب: عهدة + كاش مبيعات − كاش مرتجعات
  countedCash  Float? // المعدود فعلياً (يدخله الكاشير عند الإقفال)
  difference   Float     @default(0) // محسوب: countedCash − expectedCash (زيادة/عجز)
  notes        String?
  openedAt     DateTime  @default(now())
  closedAt     DateTime? // null = شيفت مفتوح

  @@index([branch])
  @@index([openedAt])
  @@index([closedAt])
}

// ----------------------------------------------------
//  الموردون واستلام البضاعة (Part B)
// ----------------------------------------------------
model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  receipts     StockReceipt[]
  damagedItems DamagedItem[] // مرتجعات التلف المرتبطة بهذا المورد (يُرجع للمورد)

  @@index([name])
}

model StockReceipt {
  id            String   @id @default(cuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  branch        Branch
  invoiceNumber String? // رقم فاتورة المورد (اختياري)
  totalCost     Float    @default(0) // إجمالي تكلفة الاستلام
  notes         String?
  createdBy     String? // اسم منفّذ الاستلام
  createdAt     DateTime @default(now())

  items StockReceiptItem[]

  @@index([supplierId])
  @@index([branch])
  @@index([createdAt])
}

model StockReceiptItem {
  id        String       @id @default(cuid())
  receiptId String
  receipt   StockReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  quantity Int
  unitCost Float @default(0) // تكلفة الوحدة عند هذا الاستلام

  @@index([receiptId])
  @@index([variantId])
}

// ----------------------------------------------------
//  المصروفات (Part C)
//  category كنص (rent / utilities / salaries / other) على نمط الجداول اللاحقة.
// ----------------------------------------------------
model Expense {
  id          String   @id @default(cuid())
  branch      Branch
  category    String   @default("other") // rent / utilities / salaries / other
  amount      Float    @default(0)
  description String?
  date        DateTime @default(now()) // تاريخ المصروف (قد يختلف عن createdAt)
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([branch])
  @@index([category])
  @@index([date])
}
